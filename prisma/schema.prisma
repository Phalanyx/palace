generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Palace {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  title        String
  prompt       String        @db.Text
  status       String        @default("processing") // processing | ready | error
  createdAt    DateTime      @default(now()) @map("created_at")
  documents    Document[]
  objects      Object[]
  testSessions TestSession[]

  @@map("palaces")
}

model Document {
  id                String   @id @default(uuid())
  palaceId          String   @map("palace_id")
  palace            Palace   @relation(fields: [palaceId], references: [id], onDelete: Cascade)
  fileName          String   @map("file_name")
  fileType          String   @map("file_type")  // txt | pdf | pptx
  storageUrl        String   @map("storage_url")
  rawText           String?  @map("raw_text") @db.Text
  processingStatus  String   @default("pending") @map("processing_status")
  createdAt         DateTime @default(now()) @map("created_at")
  objects           Object[]

  @@map("documents")
}

model Object {
  id          String   @id @default(uuid())
  palaceId    String   @map("palace_id")
  palace      Palace   @relation(fields: [palaceId], references: [id], onDelete: Cascade)
  documentId  String   @map("document_id")
  document    Document @relation(fields: [documentId], references: [id])
  label       String
  description String   @db.Text
  modelKey    String   @map("model_key")  // book | scroll | crystal | orb | flask | key | coin | torch
  colorHint   String?  @map("color_hint")
  orderIndex     Int      @map("order_index")
  sampleQuestion String?  @map("sample_question")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("objects")
}

model TestSession {
  id             String    @id @default(uuid())
  palaceId       String    @map("palace_id")
  palace         Palace    @relation(fields: [palaceId], references: [id], onDelete: Cascade)
  status         String    @default("in_progress") // in_progress | completed
  totalQuestions Int       @map("total_questions")
  correctAnswers Int       @default(0) @map("correct_answers")
  scorePct       Float?    @map("score_pct")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  questions      Json      // array of {objectId, questionText, userAnswer, correctAnswer, isCorrect, aiFeedback}

  @@map("test_sessions")
}
